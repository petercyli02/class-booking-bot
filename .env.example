# Copy this file to .env and fill in at least one channel.

# --- Push notification to your phone (free, no account) ---
# Install the "ntfy" app (iOS/Android), subscribe to this topic name.
# Pick something long and unguessable - anyone who knows the topic can read it.
NTFY_TOPIC=

# --- Email (Gmail: create an App Password at https://myaccount.google.com/apppasswords) ---
SMTP_USER=
SMTP_PASSWORD=
EMAIL_TO=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
